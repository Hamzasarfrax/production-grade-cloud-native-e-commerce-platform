# Example: terraform.tfvars for Staging Environment
# Copy this file to env/stag/terraform.tfvars and customize as needed

# Project Configuration
project_name = "mxmobilz"
region       = "us-east-1"
environment  = "staging"

# VPC Configuration
vpc_cidr = "10.1.0.0/16"

# EKS Configuration
kubernetes_version  = "1.28"
node_instance_type  = "t3.small"
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 6
node_disk_size      = 50
log_retention_days  = 30
public_access_cidrs = ["0.0.0.0/0"]

# RDS Configuration
database_name                = "mxmobilz_db"
database_username            = "admin"
mysql_engine_version         = "8.0"
rds_instance_class           = "db.t3.small"
rds_allocated_storage        = 50
rds_storage_type             = "gp3"
rds_multi_az                 = true
rds_backup_retention         = 14
rds_backup_window            = "03:00-04:00"
rds_maintenance_window       = "sun:04:00-sun:05:00"
rds_skip_final_snapshot      = false
rds_performance_insights     = true
rds_deletion_protection      = true
rds_iops                     = 3000

# MySQL Parameters
mysql_parameter_group_family = "8.0"
mysql_parameters = {
  "character_set_server" = "utf8mb4"
  "collation_server"     = "utf8mb4_unicode_ci"
}
