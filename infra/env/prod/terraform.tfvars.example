# Example: terraform.tfvars for Production Environment
# Copy this file to env/prod/terraform.tfvars and customize as needed

# Project Configuration
project_name = "mxmobilz"
region       = "us-east-1"
environment  = "prod"

# VPC Configuration
vpc_cidr = "10.2.0.0/16"

# EKS Configuration
kubernetes_version  = "1.28"
node_instance_type  = "t3.medium"
node_desired_size   = 3
node_min_size       = 3
node_max_size       = 10
node_disk_size      = 100
log_retention_days  = 90
public_access_cidrs = ["203.0.113.0/24"]  # Restrict to your office IP

# RDS Configuration
database_name                = "mxmobilz_db"
database_username            = "admin"
mysql_engine_version         = "8.0"
rds_instance_class           = "db.t3.medium"
rds_allocated_storage        = 100
rds_storage_type             = "gp3"
rds_multi_az                 = true
rds_backup_retention         = 30
rds_backup_window            = "03:00-04:00"
rds_maintenance_window       = "sun:04:00-sun:05:00"
rds_skip_final_snapshot      = false
rds_performance_insights     = true
rds_deletion_protection      = true
rds_iops                     = 5000

# MySQL Parameters
mysql_parameter_group_family = "8.0"
mysql_parameters = {
  "character_set_server"                = "utf8mb4"
  "collation_server"                    = "utf8mb4_unicode_ci"
  "max_connections"                     = "1000"
  "slow_query_log"                      = "1"
  "long_query_time"                     = "2"
  "log_bin_trust_function_creators"     = "1"
}
